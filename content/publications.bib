@article{yao2021subsistence,
  category = {peer-reviewed},
  title = {Study on Changes in the System of Guaranteeing the Subsistence Right for the Disabled in China (1978–2020)},
  author = {Yao, Yao},
  year = {2021},
  journal = {Journal of US-China Public Administration},
  volume = {18},
  number = {3},
  pages = {133--139},
  doi = {10.17265/1548-6591/2021.03.004},
  abstract = {In this paper, based on 45 copies of poverty alleviation policy files issued by the Central Government of China from 1978 to 2020, QSR NVivo12 was applied to conduct a qualitative analysis of corresponding policies on various stages of poverty alleviation. The research findings unveiled that variations in poverty alleviation policies for the disabled were characterized by the following content: 1) Poverty alleviation policies are changing from an universal purpose to a dedicated purpose; 2) extensive poverty alleviation is shifted to targeted poverty alleviation; 3) poverty alleviation policies should combine the social guarantee for people most in need with the initiative to increase employment income; 4) poverty alleviation policies are switched from the government’s dominant role to the diversified relief modes. In conclusion, in order to improve the system of guaranteeing the subsistence right of the disabled in China, future poverty-relief policies geared to the disabled should continue upholding the concept of targeted poverty alleviation; the basic guarantee system should be perfected for the disabled; special attention should be paid to develop self-reliance abilities of the disabled; a variety of reliefs should be implemented for the disabled.},
  selected = {true},
}

